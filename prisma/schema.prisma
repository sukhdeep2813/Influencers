// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------------------------------
// 1. YOUR CUSTOM ENUMS
// ------------------------------------------------------
enum Role {
  BRAND
  CREATOR
}

// ------------------------------------------------------
// 2. CORE USER MODEL (Updated for Better Auth)
// ------------------------------------------------------
model User {
  id    String @id @default(uuid())
  email String @unique
  role  Role   @default(BRAND)

  // --- New fields required by Better Auth ---
  name          String
  emailVerified Boolean @default(false)
  image         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Your Custom Relations ---
  brandProfile   BrandProfile?
  creatorProfile CreatorProfile?

  // --- Better Auth Relations ---
  Session Session[]
  Account Account[]
}

// ------------------------------------------------------
// 3. YOUR PROFILES
// ------------------------------------------------------
model CreatorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  name      String
  handle    String? @unique
  bio       String?
  niche     String?
  followers Int?
  avgViews  Int?
  country   String?
  city      String?
  verified  Boolean @default(false)
  avatarUrl String?

  portfolioItems PortfolioItem[]
  availability   CreatorAvailability[] 
  reviews       Review[]
  campaigns      CampaignCreator[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioItem {
  id           String         @id @default(uuid())
  creatorId    String
  creator      CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  mediaUrl     String
  thumbnailUrl String?
  views        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  BOOKED
}

model CreatorAvailability {
  id String @id @default(uuid())

  creatorId String
   creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)


  date DateTime
  status AvailabilityStatus @default(AVAILABLE)

  slots Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([creatorId, date])
  @@index([creatorId, date])
}

model Review {
  id String @id @default(uuid())

  creatorId String
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  brandId String
  brand BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)

  rating  Int
  comment String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([brandId])
}


 


model BrandProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  companyName String?
  industry    String?
  website     String?
  logoUrl     String?
  verified    Boolean @default(false)

  reviews Review[]
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Campaign{
  id String @id @default(uuid())

  brandId String
  brand BrandProfile @relation(fields :[brandId], references: [id], onDelete: Cascade)

  title       String
  description String?
  deliverables String?


  budget      Int
  deadline    DateTime?

  status      CampaignStatus @default(DRAFT)
  creators     CampaignCreator[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  

}
enum CampaignStatus{
  DRAFT
  IN_REVIEW
  LIVE
  COMPLETED
  CANCELLED
}

model CampaignCreator {
  id         String @id @default(uuid())

  // Relation to Campaign
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  // Relation to Creator
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Specific data for this creator's involvement in this campaign
  status     ApplicationStatus   @default(PENDING) // e.g., APPLIED, ACCEPTED, REJECTED
  progress   Int     @default(0)       

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Ensures a creator cannot be added to the exact same campaign twice
  @@unique([campaignId, creatorId])
}

enum ApplicationStatus{
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ------------------------------------------------------
// 4. BETTER AUTH REQUIRED MODELS
// ------------------------------------------------------
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
